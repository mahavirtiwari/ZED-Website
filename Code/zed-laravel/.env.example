APP_NAME="ZED"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://zed.msme.gov.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zedcms
DB_USERNAME=zed
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@zed.msme.gov.in"
MAIL_FROM_NAME="ZED"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SESSION_SECURE_COOKIE=true

# --- ZED ---
APP_TIMEZONE=Asia/Kolkata
# folder with uploads/, photogallery/, slider/ (relative to this app); empty = public/
ZED_STORAGE_ROOT=
# certificate verification API token (Verify ZED Certificate page)
ZED_VERIFY_TOKEN=
# local Windows only: CA file for the ZED portal APIs (.localdev/export-windows-ca.ps1)
# ZED_HTTP_CA_FILE=../../.localdev/windows-ca.pem
# Contact Us (website form) recipients
ZED_CONTACT_TO=zedtp@qcin.org
ZED_CONTACT_CC=zed@qcin.org
ZED_CONTACT_TRAINING_TO=zed@qcin.org
