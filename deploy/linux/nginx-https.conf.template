# ZED website - nginx server blocks with the free Let's Encrypt SSL certificate.
# Written by deploy.sh / enable-https.sh from deploy/linux/nginx-https.conf.template;
# do not edit on the server (the next deployment overwrites it).

server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;
    server_tokens off;

    # Let's Encrypt renewals are checked over plain http
    location ^~ /.well-known/acme-challenge/ { root __ACME__; default_type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __HOST__;

    ssl_certificate     __CERT__/fullchain.pem;
    ssl_certificate_key __CERT__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:zedcms_ssl:10m;
    ssl_session_timeout 1d;

    root  __ROOT__/current/public;
    index index.php;
    charset utf-8;
    server_tokens off;
    autoindex off;
    client_max_body_size 32m;

    access_log /var/log/nginx/zedcms.access.log;
    error_log  /var/log/nginx/zedcms.error.log warn;

    add_header Strict-Transport-Security "max-age=31536000" always;

    include __ROOT__/shared/nginx-app.conf;
}
